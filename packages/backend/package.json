{
  "name": "@vakao/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && nest start --watch -c packages/backend/nest-cli.json",
    "build": "cd ../.. && nest build -c packages/backend/nest-cli.json",
    "start": "node dist/main.js",
    "db:sync": "cd ../.. && nest build -c packages/backend/nest-cli.json && node packages/backend/dist/scripts/sync-db.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint src --fix",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@vakao/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.15.0"
  },
  "imports": {
    "#/*": "./dist/*"
  }
}
