# 服务监听地址与端口
HOST=0.0.0.0
PORT=9865
# 运行期基准目录；留空取进程工作目录。根目录下的相对路径都基于它解析
# BASE_DIR=

# 认证配置
# 首次启动时 users 表为空会用它播种管理员（至少 6 位）；AUTH_PASS 留空则不播种
AUTH_USER=admin
AUTH_PASS=admin123
# 生产环境务必改为随机长字符串
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=12h

# 跨域来源白名单，逗号分隔；留空不开放跨域
CORS_ORIGIN=
# 位于可信反向代理后时设为 true，才会采用 X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=false

# 数据与存储（相对路径基于 BASE_DIR 解析）
DB_PATH=data/vakao.db
FILE_ROOT=data
RESOURCE_ROOTS_FILE=resource-roots.json
# 分片上传临时目录；默认 data/.uploads
UPLOAD_TEMP_DIR=data/.uploads
# 缩略图缓存目录；默认 data/.cache
CACHE_DIR=data/.cache

# 上传与图片处理
UPLOAD_MAX_COUNT=20
DEFAULT_CATEGORY=TemporaryFile
# 单个分片文件大小硬上限（字节），默认 100MB
CHUNK_FILE_SIZE_LIMIT=104857600
# 缩略图允许解码的最大像素数与最大边长
MAX_IMAGE_PIXELS=60000000
MAX_IMAGE_DIMENSION=4096
THUMB_CONCURRENCY=2

# 文件索引同步间隔（毫秒）
CACHE_REFRESH_INTERVAL_MS=300000

# 服务器目录浏览白名单（逗号分隔的绝对路径）。
# 默认可浏览：运行用户主目录 + 每个已配置根目录的父级
# ROOT_BROWSE_WHITELIST=/www/wwwroot,/var/www

# 前端构建产物目录；同源部署时由服务端托管，默认 web
# WEB_DIR=web

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 一言代理目标，留空则禁用代理
HITOKOTO_API_URL=https://static.shixian.xyz/static/hitokoto

# APP 安装包下载链接的外部可访问基址；留空时按请求头动态拼接
# APP_PUBLIC_BASE_URL=https://example.com
