# ============================================================
# Vakao Static Hub 环境变量示例
#
# 复制为 .env 后按需修改。每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# 「留空」与「删除该行」等价，两者都走默认值。
# 相对路径一律基于 BASE_DIR 解析。
# ============================================================

# ---------- 服务基础 ----------

# HOST：HTTP 监听地址。【可选】默认 0.0.0.0
# 示例：0.0.0.0（所有网卡）| 127.0.0.1（仅本机，需反代）
# 取值：按部署方式自行决定；宝塔/反代之后通常保持 0.0.0.0
HOST=0.0.0.0

# PORT：HTTP 监听端口。【可选】默认 9865
# 示例：9865
# 取值：自行指定，需与反代/防火墙放行端口一致
PORT=9865

# BASE_DIR：运行期基准目录。【可选】默认进程工作目录
# 示例：/www/wwwroot/vakao-static-hub
# 取值：一般留空；systemd 等场景下工作目录不确定时才显式指定
# BASE_DIR=

# WEB_DIR：前端构建产物目录，由服务端托管。【可选】默认 web
# 示例：web（相对 BASE_DIR）| /srv/vakao-web（绝对路径）
# 取值：发布包内自带的 web/ 目录即可，前后端分离部署时指向实际目录
# WEB_DIR=web

# LOG_LEVEL：日志级别。【可选】默认 info
# 示例：debug | info | warn | error
# 取值：排查问题用 debug，日常用 info
LOG_LEVEL=info

# ---------- 认证与分享签名 ----------

# AUTH_USER：首次启动播种的管理员用户名。【可选】默认 admin
# 示例：admin
# 取值：自行指定；仅在 users 表为空时生效一次
AUTH_USER=admin

# AUTH_PASS：首次启动播种的管理员密码。【可选】默认空（不播种）
# 示例：Admin@2026-strong
# 取值：自行指定，至少 6 位；上线后请立即在「用户」页改掉示例值
AUTH_PASS=admin123

# JWT_SECRET：登录令牌的签名密钥。【必填】无默认值，至少 16 字节
# 示例：9f2c7b1e4a8d5c30b6e7f1a2d4c8b9e0
# 取值：自行生成，例如 openssl rand -hex 32；泄露等同于会话可被伪造
JWT_SECRET=change-me-in-env

# JWT_EXPIRES_IN：登录令牌有效期。【可选】默认 12h
# 示例：30m | 12h | 7d
# 取值：按安全要求自行决定
JWT_EXPIRES_IN=12h

# SHARE_SIGN_KEY：公开分享文件地址的签名密钥。【必填】无默认值，至少 16 字节
# 示例：3c7e1a90f4b2d6859e0c1a37b5d8426f
# 取值：自行生成，例如 openssl rand -hex 32；换掉它等于让所有已发出的分享文件地址一次性作废
SHARE_SIGN_KEY=change-me-in-env

# ---------- 网络与跨域 ----------

# CORS_ORIGIN：跨域来源白名单。【可选】默认空（不开放跨域）
# 示例：https://a.example.com,https://b.example.com（逗号分隔，不要带结尾斜杠）
# 取值：仅当前端独立域名访问 API 时才需要填
CORS_ORIGIN=

# TRUST_PROXY：是否采信反向代理传来的头。【可选】默认 false
# 示例：true | false
# 取值：前面有 Nginx/CDN 时填 true，否则访问日志里的 IP 会全是反代地址
TRUST_PROXY=false

# ---------- 数据与存储（相对路径基于 BASE_DIR） ----------

# DB_PATH：SQLite 数据库文件路径。【可选】默认 data/vakao.db
# 示例：data/vakao.db
# 取值：自行指定；迁移机器时记得一并备份
DB_PATH=data/vakao.db

# FILE_ROOT：默认资源根目录（文件实际存放位置）。【可选】默认 data
# 示例：data | /data/files
# 取值：自行指定；可被 resource-roots.json 里的多根配置覆盖
FILE_ROOT=data

# RESOURCE_ROOTS_FILE：资源根播种文件。【可选】默认 resource-roots.json
# 示例：resource-roots.json
# 取值：只在数据库为空时读取一次，用于首次导入根目录列表
RESOURCE_ROOTS_FILE=resource-roots.json

# UPLOAD_TEMP_DIR：分片上传临时目录。【可选】默认 data/.uploads
# 示例：data/.uploads
# 取值：自行指定；需与最终存储同盘，避免上传完成时跨盘移动
UPLOAD_TEMP_DIR=data/.uploads

# CACHE_DIR：缩略图等派生内容缓存目录。【可选】默认 data/.cache
# 示例：data/.cache
# 取值：自行指定；可随时清空，只会触发重新生成
CACHE_DIR=data/.cache

# ---------- 上传与图片处理 ----------

# UPLOAD_MAX_COUNT：单次批量上传的文件数上限。【可选】默认 20
# 示例：20
# 取值：正整数
UPLOAD_MAX_COUNT=20

# CHUNK_FILE_SIZE_LIMIT：单个分片文件的硬上限（字节）。【可选】默认 104857600（100MB）
# 示例：104857600
# 取值：正整数；小于前端分片大小时上传会失败
CHUNK_FILE_SIZE_LIMIT=104857600

# DEFAULT_CATEGORY：未指定分类时的默认目录名。【可选】默认 TemporaryFile
# 示例：TemporaryFile
# 取值：默认资源根下真实存在的子目录名
DEFAULT_CATEGORY=TemporaryFile

# MAX_IMAGE_PIXELS：缩略图允许解码的最大像素数。【可选】默认 60000000（6000 万）
# 示例：60000000
# 取值：正整数；按内存调整，越大越容易被超大图拖垮
MAX_IMAGE_PIXELS=60000000

# MAX_IMAGE_DIMENSION：缩略图最大边长（像素）。【可选】默认 4096
# 示例：4096
# 取值：正整数
MAX_IMAGE_DIMENSION=4096

# THUMB_CONCURRENCY：缩略图生成并发数。【可选】默认 2
# 示例：2
# 取值：正整数；按 CPU/内存设置
THUMB_CONCURRENCY=2

# THUMB_CACHE_RETENTION_DAYS：缩略图缓存保留天数。【可选】默认 30
# 示例：30
# 取值：正整数；0 表示不按时间清理
THUMB_CACHE_RETENTION_DAYS=30

# THUMB_CACHE_MAX_MB：缩略图缓存总容量上限（MB）。【可选】默认 512
# 示例：512
# 取值：正整数；0 表示不限容量
THUMB_CACHE_MAX_MB=512

# CLEANUP_AT：每日清理时刻（HH:MM，服务器本地时区）。【可选】默认 03:00
# 示例：03:00
# 取值：24 小时制；清理缩略图缓存与已过期分享
CLEANUP_AT=03:00

# ---------- 文件索引与目录浏览 ----------

# CACHE_REFRESH_INTERVAL_MS：文件索引同步间隔（毫秒）。【可选】默认 300000（5 分钟）
# 示例：300000
# 取值：正整数；服务器磁盘上直接增删文件后，最迟这么久能被页面看到
CACHE_REFRESH_INTERVAL_MS=300000

# ROOT_BROWSE_WHITELIST：目录浏览白名单（逗号分隔的绝对路径）。【可选】默认按运行用户推导
# 示例：/www/wwwroot,/var/www
# 取值：默认可浏览运行用户主目录 + 每个已配置根目录的父级；要浏览别处时显式列出
# ROOT_BROWSE_WHITELIST=/www/wwwroot,/var/www

# ---------- Office 预览（pptx/ppt/doc 与 docx 渲染失败兜底） ----------

# OFFICE_CONVERT_CONCURRENCY：同时转换的文档数。【可选】默认 2
# 示例：2
# 取值：正整数；2GB 内存机器建议 2，内存更大可上调
OFFICE_CONVERT_CONCURRENCY=2

# OFFICE_CONVERT_TIMEOUT：单次转换超时时间。【可选】默认 90s
# 示例：90s | 2m
# 取值：Go duration 格式；过小会让大文件频繁超时
OFFICE_CONVERT_TIMEOUT=90s

# OFFICE_MAX_INPUT_MB：允许转换的单文件上限（MB）。【可选】默认 20
# 示例：20
# 取值：正整数；超过直接返回 422，不进入转换队列
OFFICE_MAX_INPUT_MB=20

# OFFICE_CACHE_DIR：转换缓存目录。【可选】默认系统临时目录下的专属子目录
# 示例：/tmp/vakao-static-hub-office
# 取值：一般留空；交给系统回收即可，被清掉只会让文件重新转换一次，不要指向站点数据目录
# OFFICE_CACHE_DIR=/tmp/vakao-static-hub-office

# SOFFICE_PATH：LibreOffice 可执行文件。【可选】默认从 PATH 查找 soffice
# 示例：soffice | /usr/bin/soffice
# 取值：用 `which soffice` 的结果；Windows/macOS 本地调试时填完整路径
SOFFICE_PATH=soffice

# ---------- 附加功能 ----------

# HITOKOTO_API_URL：一言代理目标地址。【可选】默认官方示例地址
# 示例：https://static.shixian.xyz/static/hitokoto
# 取值：留空则关闭一言代理；指向兼容 hitokoto 返回格式的接口即可
HITOKOTO_API_URL=https://static.shixian.xyz/static/hitokoto

# APP_PUBLIC_BASE_URL：APP 安装包下载链接的外部可访问基址。【可选】默认按请求头拼接
# 示例：https://static.example.com
# 取值：部署在 CDN/反代后面、需要固定外链域名时填写，不要带结尾斜杠
# APP_PUBLIC_BASE_URL=https://example.com

# ---------- 分享文件 CDN 缓存刷新（三项齐全才启用） ----------

# TENCENTCLOUD_SECRET_ID：腾讯云 API SecretId。【可选】默认空（不启用刷新）
# 示例：AKIDxxxxxxxxxxxxxxxxxxxxxxxx
# 取值：腾讯云控制台 → 访问管理 CAM → 密钥管理 → API 密钥管理；建议用只授予 EdgeOne 刷新权限的子账号
TENCENTCLOUD_SECRET_ID=

# TENCENTCLOUD_SECRET_KEY：腾讯云 API SecretKey。【可选】默认空
# 示例：与 SecretId 成对生成的长字符串
# 取值：同上，创建 API 密钥时只显示一次，请立即保存
TENCENTCLOUD_SECRET_KEY=

# EDGEONE_ZONE_ID：EdgeOne 站点 ID。【可选】默认空
# 示例：zone-xxxxxxxxxxxx
# 取值：腾讯云 EdgeOne 控制台 → 站点列表 → 对应站点详情里的「站点 ID」
EDGEONE_ZONE_ID=

# 说明：三项留空时撤销分享不会调用任何外部接口，仅靠分享文件的
# 7 天缓存（public, max-age=604800，不带 immutable）自然过期。
