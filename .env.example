# 服务器配置
PORT=9865
# JSON 请求体上限（不作用于 multipart 上传；普通文件上传无大小限制，APK 单包硬上限 500MB）
BODY_LIMIT=10mb
STATIC_PREFIX=/static
# 前端构建产物目录（同源部署时由后端托管）；留空默认 <仓库根>/packages/frontend/dist
# WEB_DIR=packages/frontend/dist
# 允许跨域调用后端 API 的来源（如 Vite dev server），多个用逗号分隔，留空则不开放跨域
CORS_ORIGIN=
# 是否挂载 Swagger 接口文档（/docs），生产环境建议设为 false
ENABLE_SWAGGER=true

# 认证配置
# AUTH_USER/AUTH_PASS 用于初始化默认管理员账号（dev 自动同步或 pnpm db:sync 时播种）
AUTH_USER=admin
AUTH_PASS=admin
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=12h

# 数据库配置（相对路径基于 backend 包根 packages/backend/ 解析）
# DB_PATH=data/vakao.db
# 开发环境开关：true 时启动自动按实体同步表结构并播种；false 时启动完全不碰结构。
# 未配置时默认 false；本地开发建议 true，改完实体直接重启即可生效。
# 生产环境会忽略该开关（启动日志会警告），结构变更一律执行 pnpm db:sync。
DB_SYNCHRONIZE=true

# 文件配置（相对路径基于 backend 包根 packages/backend/ 解析）
# FILE_ROOT=data
UPLOAD_MAX_COUNT=20
DEFAULT_CATEGORY=TemporaryFile
# 服务器目录浏览白名单（逗号分隔的绝对路径）。
# 默认可浏览：运行用户主目录 + 每个已配置根目录的父级；
# 要浏览其它位置（如 /www/wwwroot、/data）在此追加，改完需重启进程。
# ROOT_BROWSE_WHITELIST=/www/wwwroot,/var/www
# 分片上传临时目录：默认落在操作系统临时目录下的应用专属子目录（os.tmpdir()/vakao-static-hub/uploads）
# 线上如 /tmp 挂了 tmpfs 且内存吃紧，可指回磁盘目录（如 /var/vakao-uploads）
# UPLOAD_TEMP_DIR=
# 单个分片文件大小硬上限（字节），防超大 buffer 打垮进程内存；默认 100MB
# CHUNK_FILE_SIZE_LIMIT=104857600

# 计划任务配置
# 5 minutes in ms
CACHE_REFRESH_INTERVAL_MS=300000

# 一言 API 配置
# 后端代理目标（前端统一请求 /static/hitokoto，由后端转发到该地址）
# 默认值（不配置时生效）：https://static.shixian.xyz/static/hitokoto
# 真实开发 / 生产环境保持默认；本地需要指向本地一言服务时取消注释并覆盖，例如：
# HITOKOTO_API_URL=http://127.0.0.1:3000/static/hitokoto
# HITOKOTO_API_URL=https://static.shixian.xyz/static/hitokoto

# APP 在线更新配置
# APK 下载链接的外部可访问基址；留空时从请求头（x-forwarded-* / Host）动态拼接
# APP_PUBLIC_BASE_URL=https://example.com
