{
  "name": "vakao-static-hub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install && go -C packages/server mod download",
    "dev": "pnpm build:shared && concurrently -n server,client -c green,blue \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "BASE_DIR=\"$PWD\" go -C packages/server run ./cmd/server",
    "dev:client": "pnpm --filter @vakao/client dev",
    "build": "pnpm build:shared && pnpm build:server && pnpm build:client",
    "build:shared": "pnpm --filter @vakao/shared build",
    "build:server": "go -C packages/server build -o bin/vakao-server ./cmd/server",
    "build:client": "pnpm --filter @vakao/client build",
    "package": "bash scripts/package.sh",
    "start": "BASE_DIR=\"$PWD\" WEB_DIR=\"$PWD/packages/client/dist\" ./packages/server/bin/vakao-server",
    "typecheck": "pnpm --filter @vakao/shared typecheck && pnpm --filter @vakao/client typecheck",
    "test": "go -C packages/server test ./...",
    "vet": "go -C packages/server vet ./...",
    "lint": "pnpm --filter @vakao/shared lint && pnpm --filter @vakao/client lint",
    "format": "prettier --write \"packages/**/*.{ts,vue}\" && gofmt -w packages/server",
    "format:check": "prettier --check \"packages/**/*.{ts,vue}\" && sh -c 'out=$(gofmt -l packages/server); if [ -n \"$out\" ]; then echo \"$out\"; exit 1; fi'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vakao-ui/scripts-utils": "^0.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.15.0"
  }
}
